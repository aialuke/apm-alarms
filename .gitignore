.DS_Store
_site/
.jekyll-cache/
.bundle/
vendor/

# Impeccable. One copy of the skill lives in .agents/skills/impeccable and each tool folder links to it.
# In git: the design memory (.impeccable/config.json, design.json, surfaces/, live/config.json,
# critique/ignore.md) and the hook, agent and skill-link files for each tool.
# Left out, as the vendor's own .gitignore does: temporary and per-run files, including the critique
# snapshots (they record this Mac's folder paths).
.impeccable/hook.cache.json
.impeccable/hook.pending.json
**/.impeccable/hook.cache.json
**/.impeccable/hook.pending.json
.impeccable/config.local.json
.impeccable/live/server.json
.impeccable/live/roots.json
.impeccable/live/app-root.json
.impeccable/live/inject-journal.json
.impeccable/live/codex-worker.json
.impeccable/live/codex-worker.log
.impeccable/live/sessions/
.impeccable/live/previews/
.impeccable/live/annotations/
.impeccable/live/artifacts/
.impeccable/live/accept-receipts/
.impeccable/live/locks/
.impeccable/live/cache/
.impeccable/live/benchmarks/
.impeccable/live/manual-edit-apply-transaction.json
.impeccable/live/manual-edit-events.jsonl
.impeccable/live/manual-edit-evidence/
.impeccable/live/pending-manual-edits.json
.impeccable/live/deferred-svelte-component-accepts.json
.impeccable/history/
.impeccable/provider-smoke/
.impeccable/critique/*
!.impeccable/critique/ignore.md
.impeccable-live.json
.impeccable-live/
.impeccable/*.png
**/skills/impeccable/scripts/config.json
**/skills/impeccable/scripts/bin/

# Tool folders: keep the skill and agent links, the Cursor and Grok hooks, and Claude Code's shared settings.
.grok/*
!.grok/skills/
!.grok/hooks/
!.grok/agents/
.claude/*
!.claude/skills/
!.claude/agents/
!.claude/settings.json

# Local research trail. Not a phone page.
.audit/
